# 이 파일은 "템플릿"입니다. 실제 키를 넣지 마세요 (git에 커밋됨).
# 실제 값은 .env 파일에 채워 넣으세요 (.gitignore로 무시됨).
# 최초 세팅: cp .env.example .env  후 아래 빈칸을 채우기

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://hazard:hazard@localhost:5432/hazard_fighter

# 공공데이터포털 (data.go.kr) - 기상특보 조회서비스 (15000415)
KMA_WARNING_API_KEY=

# 공공데이터포털 (data.go.kr) - 지진정보 조회서비스 (15000420, 자동승인)
KMA_EARTHQUAKE_API_KEY=

# 홍수통제소 오픈API (hrfco.go.kr에서 별도 발급 — data.go.kr 키와 다름)
HRFCO_API_KEY=

# 재난안전데이터공유플랫폼 (safetydata.go.kr) - 긴급재난문자
SAFETYDATA_API_KEY=

# LLM (알림 문구 생성용, Phase 2에서 사용) — 둘 중 하나만 채우면 됨
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LLM 무료 폴백 (선택) — 유료 quota 소진 시 자동 전환됨 (OpenAI 호환 API 면 무엇이든 가능)
# 예: Google Gemini 무료 티어 — https://aistudio.google.com/apikey 에서 키 발급
# LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_FALLBACK_MODEL=gemini-flash-lite-latest
#   ("latest" 별칭 권장 — 구버전 모델명은 무료 티어가 닫히면 limit 0/429 가 난다.
#    사용 가능 모델 확인: GET {BASE_URL}/models)
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# 주기 수집 스케줄러 (기본값으로 충분 — 바꿀 때만 주석 해제)
# 10분 주기 = 하루 144사이클. 재난문자 일일 한도(1,000) 때문에 10분 미만으로 줄이지 말 것
# SCHEDULER_ENABLED=1
# INGEST_INTERVAL_MINUTES=10
# INGEST_MIN_GAP_MINUTES=3

# Firebase Cloud Messaging (Phase 2 웹푸시 연동 시 사용)
# 레거시 FCM_SERVER_KEY는 2024.7 폐기됨 → 서비스 계정 JSON 방식 사용
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
FCM_PROJECT_ID=hazard-fighter
# 클라우드 배포용 대안: 파일을 올릴 수 없는 환경(PaaS)에서는 JSON 내용을 이 변수에 한 줄로.
# 둘 다 있으면 이쪽이 우선. 예: FCM_CREDENTIALS_JSON={"type":"service_account",...}
FCM_CREDENTIALS_JSON=

# Firebase 웹 클라이언트 설정 (PWA가 FCM 웹 토큰을 발급받을 때 필요 — 브라우저에 공개되는 값이라 시크릿 아님)
# Firebase 콘솔 > 프로젝트 설정 > 일반 > "내 앱"에서 웹 앱(</>) 추가 후 값 복사
FCM_WEB_API_KEY=
FCM_WEB_APP_ID=
FCM_WEB_MESSAGING_SENDER_ID=
# 콘솔 > 프로젝트 설정 > 클라우드 메시징 > "웹 푸시 인증서"에서 키 쌍 생성 후 공개키 복사
FCM_VAPID_KEY=

# 인증 (소셜 로그인 + JWT). JWT_SECRET 은 아무 긴 난수 문자열 — 예: openssl rand -hex 32 로 생성
JWT_SECRET=
# Google Cloud 콘솔 > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID(웹 애플리케이션)
# 승인된 리디렉션 URI 에 http://localhost:8000/auth/google/callback 등록 (배포 시 실제 도메인 추가)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Kakao Developers (developers.kakao.com) > 내 애플리케이션 > 앱 키 > REST API 키
# 카카오 로그인 활성화 + Redirect URI 에 http://localhost:8000/auth/kakao/callback 등록
# 동의항목은 닉네임만 (이메일은 비즈 앱 필요라 수집 안 함). client secret 은 콘솔에서 켠 경우만.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# API 문서(/docs·/redoc·/openapi.json) 노출. 로컬은 켜두고(기본값), 배포엔 0 을 준다.
# 문서가 비밀이라서가 아니라, 스캐너에게 엔드포인트 목록을 떠먹여 줄 이유가 없어서.
# DOCS_ENABLED=1

# 수집 엔드포인트(POST /events/ingest) 보호 토큰. X-Ingest-Token 헤더로 보낸다.
# 배포 후엔 외부 스케줄러(Cloud Scheduler)가 이 헤더를 실어 10분마다 호출한다.
# 미설정이면 해당 엔드포인트는 503 (fail-closed — 잊었을 때 열려 있지 않도록).
# 생성 예: openssl rand -hex 32
INGEST_TOKEN=
