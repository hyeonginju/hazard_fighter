{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hazard-fighter",
      "url": "http://localhost:8000",
      "port": 8000
    },
    {
      "name": "hazard-fighter-ui",
      "runtimeExecutable": "env",
      "runtimeArgs": ["SCHEDULER_ENABLED=false", ".venv/bin/uvicorn", "app.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "static-demo",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8080", "--directory", "static-site"],
      "port": 8080
    }
  ]
}
